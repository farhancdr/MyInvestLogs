node_modules/
dist/
.DS_Store

# Playwright output. Screenshots under docs/images/ ARE committed — they are
# regenerated by the suite and shown in the README.
test-results/
playwright-report/
blob-report/

# The database itself IS committed — it is the only copy of your records.
# The app runs in rollback-journal mode so everything lives in that one file;
# these sidecars should never appear, and are ignored only as a safety net.
data/*.db-wal
data/*.db-shm
data/*.db-journal
